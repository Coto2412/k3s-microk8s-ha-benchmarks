global:
  scrape_interval: {{ prometheus_scrape_interval }}

# Los objetivos y sus etiquetas (incluida distribution) viven en archivos que el operador reescribe
# con `python3 -m k6.operacion.etiqueta`; Prometheus los relee sin reiniciar (E1, Etapa 4).
scrape_configs:
{% for trabajo in prometheus_trabajos %}
  - job_name: {{ trabajo.job }}
{% if trabajo.job == 'scaphandre' %}
    fallback_scrape_protocol: PrometheusText0.0.4
{% endif %}
    file_sd_configs:
      - files: ["{{ prometheus_objetivos_dir }}/{{ trabajo.job }}.json"]
        refresh_interval: 30s
{% if trabajo.keep is defined %}
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: '{{ trabajo.keep }}'
        action: keep
{% endif %}

{% endfor %}
