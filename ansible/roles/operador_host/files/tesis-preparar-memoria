#!/usr/bin/python3 -I
"""Libera el swap (swapoff -a; swapon -a) y vacía la caché de páginas. Imprime un JSON con la memoria antes y después.

Se llama sin argumentos con sudo (regla exacta en /etc/sudoers.d/tesis-operador). Sale con 1 si algún paso falla.
"""
import json, os, subprocess, sys, time


def memoria():
    d = {}
    for linea in open("/proc/meminfo"):
        k, v = linea.split(":", 1)
        d[k] = int(v.split()[0])
    return {k + "_kB": d[k] for k in ("MemAvailable", "MemFree", "Cached", "SwapTotal", "SwapFree")}


def correr(orden):
    r = subprocess.run(orden, capture_output=True, text=True)
    return None if r.returncode == 0 else f"{' '.join(orden)}: rc={r.returncode} {r.stderr.strip()}"


if len(sys.argv) > 1:
    sys.exit("tesis-preparar-memoria no recibe argumentos")
r = {"t_inicio": time.time(), "antes": memoria(), "errores": []}
t0 = time.monotonic()
r["errores"].append(correr(["/usr/sbin/swapoff", "-a"]))
r["errores"].append(correr(["/usr/sbin/swapon", "-a"]))  # siempre, aunque swapoff falle a medias
t1 = time.monotonic()
os.sync()
with open("/proc/sys/vm/drop_caches", "w") as fh:
    fh.write("3\n")
t2 = time.monotonic()
r["errores"] = [e for e in r["errores"] if e]
r.update(despues=memoria(), duracion_s={"swap": round(t1 - t0, 3), "cache": round(t2 - t1, 3), "total": round(t2 - t0, 3)},
         resultado="ok" if not r["errores"] else "error")
print(json.dumps(r))
sys.exit(0 if r["resultado"] == "ok" else 1)
