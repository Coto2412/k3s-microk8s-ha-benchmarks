apiVersion: v1
kind: ConfigMap
metadata:
  name: nginx-referencia
  namespace: default
data:
  nginx.conf: |
    load_module modules/ngx_http_js_module.so;
    user  nginx;
    worker_processes  auto;
    error_log  /var/log/nginx/error.log notice;
    pid        /run/nginx.pid;
    events {
        worker_connections  1024;
    }
    http {
        include       /etc/nginx/mime.types;
        default_type  application/octet-stream;
        sendfile        on;
        keepalive_timeout  65;
        include /etc/nginx/conf.d/*.conf;
    }
  default.conf: |
    js_import sha from /etc/nginx/njs/sha.js;
    server {
        listen 80 default_server;
        access_log off;
        location = /healthz {
            default_type text/plain;
            return 200 "ok\n";
        }
        location / {
            default_type text/plain;
            js_content sha.hash;
        }
    }
  sha.js: |
    import crypto from 'crypto';
    function hash(r) {
        var h = 'referencia';
        for (var i = 0; i < {{ nginx_sha_iteraciones }}; i++) {
            h = crypto.createHash('sha256').update(h).digest('hex');
        }
        r.return(200, h + '\n');
    }
    export default { hash };
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: nginx-referencia
  namespace: default
  labels:
    app: nginx-referencia
spec:
  replicas: 1
  selector:
    matchLabels:
      app: nginx-referencia
  template:
    metadata:
      labels:
        app: nginx-referencia
    spec:
      nodeSelector:
        kubernetes.io/hostname: {{ app_node }}
      containers:
        - name: nginx
          image: {{ nginx_image }}
          ports:
            - containerPort: 80
          readinessProbe:
            httpGet:
              path: /healthz
              port: 80
            periodSeconds: 5
          resources:
            requests:
              cpu: {{ nginx_cpu_request }}
              memory: {{ nginx_memory }}
            limits:
              cpu: {{ nginx_cpu_limit }}
              memory: {{ nginx_memory }}
          volumeMounts:
            - name: config
              mountPath: /etc/nginx/conf.d/default.conf
              subPath: default.conf
            - name: config
              mountPath: /etc/nginx/nginx.conf
              subPath: nginx.conf
            - name: config
              mountPath: /etc/nginx/njs/sha.js
              subPath: sha.js
      volumes:
        - name: config
          configMap:
            name: nginx-referencia
