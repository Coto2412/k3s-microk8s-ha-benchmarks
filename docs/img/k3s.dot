digraph k3s {
  rankdir=TB; fontname="Helvetica"; node [fontname="Helvetica", shape=box, style="rounded,filled", fillcolor="#f4f4f4"]; edge [fontname="Helvetica", fontsize=10];
  subgraph cluster_host { label="Host físico (QEMU/KVM + libvirt)"; style="rounded"; 
    subgraph cluster_net { label="Red libvirt NAT 192.168.100.0/24"; style="rounded,dashed";
      gw [label="Host / gateway\n.1"];
      vip [label="VIP plano de control\n.100:6443 (kube-vip, ARP)", fillcolor="#dbeafe"];
      n1 [label="k3s-node1 .11\nserver + etcd"]; n2 [label="k3s-node2 .12\nserver + etcd"]; n3 [label="k3s-node3 .13\nserver + etcd"];
    }
  }
  gw -> n1 [dir=none]; gw -> n2 [dir=none]; gw -> n3 [dir=none];
  vip -> n1 [style=dashed, label="líder"]; vip -> n2 [style=dotted]; vip -> n3 [style=dotted];
  n1 -> n2 [dir=both, label="etcd"]; n2 -> n3 [dir=both, label="etcd"]; n1 -> n3 [dir=both, label="etcd"];
}
