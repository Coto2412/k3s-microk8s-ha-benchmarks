[Unit]
Description=Node Exporter
After=network.target

[Service]
Type=simple
User=node_exporter
Group=node_exporter
ExecStart=/usr/local/bin/node_exporter --web.listen-address={{ ansible_host }}:{{ node_exporter_port }} --collector.disable-defaults{% for c in node_exporter_collectors %} --collector.{{ c }}{% endfor +%}
Restart=on-failure

[Install]
WantedBy=multi-user.target
