# Configuración global de haproxy
global
  log /dev/log local0
  log /dev/log local1 notice
  chroot /var/lib/haproxy
  stats socket /run/haproxy/admin.sock mode 660 level admin
  stats timeout 30s
  user haproxy
  group haproxy
  daemon

  # Cifrados SSL predeterminados
  ssl-default-bind-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256
  ssl-default-bind-ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384
  ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets

# Configuración predeterminada para todos los frontends y backends
defaults
  log global
  mode tcp
  option tcplog
  option dontlognull
  timeout connect 5000
  timeout client 50000
  timeout server 50000
  retries 3

# Frontend: punto de entrada para la API de microk8s en el puerto 16444.
# Se usa un puerto DIFERENTE al del API server (16443) porque en Linux un puerto
# solo puede tener un listener (wildcard + bind específico NO coexisten en estos kernels).
frontend microk8s_api
  bind {{ haproxy_bind_ip | default('0.0.0.0') }}:16444
  mode tcp
  option tcplog
  default_backend microk8s_servers

# Backend: servidores microk8s con balanceo roundrobin en el puerto real del API server
backend microk8s_servers
  mode tcp
  option tcp-check
  balance roundrobin
  server microk8s-node1 192.168.100.10:16443 check
  server microk8s-node2 192.168.100.11:16443 check
  server microk8s-node3 192.168.100.12:16443 check
